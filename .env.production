# 生产环境前端配置 / Production frontend config
# 前后端同域名走 Nginx 反向代理, 直接用相对路径 /api 最省事、无跨域问题
# Same-origin via Nginx reverse proxy: use relative /api
VITE_API_BASE_URL=/api

# Google Ads 脚本服务器地址 / Google Ads script server base URL
# 生成脚本时注入到 API_BASE_URL, 不写死在组件里
# 本系统部署在 track 子域, www 留给内容站 / this system lives on track; www is the content site
VITE_ADS_SCRIPT_NORMAL_BASE_URL=https://track.lunalvabeau.com
# Matrix 模板同源; 缺失时会回退到旧域名 / same origin for Matrix; a missing value falls back to a legacy host
VITE_ADS_SCRIPT_MATRIX_BASE_URL=https://track.lunalvabeau.com
