# 生产环境前端配置 / Production frontend config
# 前后端同域名走 Nginx 反向代理, 直接用相对路径 /api 最省事、无跨域问题
# Same-origin via Nginx reverse proxy: use relative /api
VITE_API_BASE_URL=/api

# Google Ads 脚本服务器地址 / Google Ads script server base URL
# 生成脚本时注入到 API_BASE_URL, 不写死在组件里
VITE_ADS_SCRIPT_NORMAL_BASE_URL=https://www.lunalvabeau.com
